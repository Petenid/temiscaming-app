// Who may read and write the Firestore database from the app.
// Deploy with: firebase deploy --only firestore:rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Town alerts, pickups, events, weather, fire bans and the health of each source are public information:
    // anyone may read them. Nobody may write from the app; only the backend
    // (Cloud Functions) writes, and it isn't bound by these rules.
    match /alerts/{alertId} {
      allow read: if true;
      allow write: if false;
    }
    // Collection pickups (Milestone 2): public schedule, read-only.
    match /collections/{pickupId} {
      allow read: if true;
      allow write: if false;
    }
    // Town events (Milestone 3): public calendar, read-only.
    match /events/{eventId} {
      allow read: if true;
      allow write: if false;
    }
    // Weather for Témiscaming (Milestone 4): one public, read-only document.
    match /weather/{docId} {
      allow read: if true;
      allow write: if false;
    }
    // Fire bans for Témiscaming (Milestone 6): one public, read-only document.
    match /fire/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /sources/{sourceId} {
      allow read: if true;
      allow write: if false;
    }
    // Manual corrections to alerts (spec town-alerts §5c): edited by hand in
    // the Firebase console, which isn't bound by these rules. The backend
    // copies them onto each alert, so the app never needs to read them.
    match /overrides/{alertId} {
      allow read, write: if false;
    }
    // Everything else stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
