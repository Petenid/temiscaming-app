// Who may read and write the Firestore database from the app.
// Deploy with: firebase deploy --only firestore:rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Town alerts and the health of each source are public information:
    // anyone may read them. Nobody may write from the app; only the backend
    // (Cloud Functions) writes, and it isn't bound by these rules.
    match /alerts/{alertId} {
      allow read: if true;
      allow write: if false;
    }
    match /sources/{sourceId} {
      allow read: if true;
      allow write: if false;
    }
    // Everything else stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
